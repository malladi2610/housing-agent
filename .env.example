# Copy to .env; never commit credentials. The local setup screen can save the
# Ollama key in ignored data/secrets.json instead of this file.
FLAT_DATA_DIR=data
FLAT_HOST=127.0.0.1
FLAT_PORT=8000
OLLAMA_API_KEY=
# Leave empty for direct localhost use. Set a strong password before allowing
# access from another machine. Username is always "owner".
FLAT_UI_PASSWORD=
# Optional saved-search email ingestion. Read-only, SSL only.
FLAT_IMAP_HOST=
FLAT_IMAP_PORT=993
FLAT_IMAP_USER=
FLAT_IMAP_PASSWORD=
FLAT_IMAP_FOLDER=INBOX
FLAT_IMAP_SENDERS=
FLAT_IMAP_POLL_SECONDS=180
# Local Appium, shared by macOS/Windows physical Android and emulator adapters.
FLAT_APPIUM_URL=http://127.0.0.1:4723
